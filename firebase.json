{
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["npm run build"],
    "rewrites": [
      {
        "source": "/api/**",
        "function": { "functionId": "api", "region": "europe-west1" }
      },
      {
        "source": "/.well-known/assetlinks.json",
        "function": { "functionId": "api", "region": "europe-west1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
      }
    ]
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", "test", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
    }
  ],
  "firestore": {
    "database": "(default)",
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": { "port": 9399 },
    "firestore": { "port": 8281, "websocketPort": 9250 },
    "functions": { "port": 5021 },
    "hosting": { "port": 5002 },
    "hub": { "port": 4420 },
    "logging": { "port": 4520 },
    "ui": { "enabled": true, "port": 4020 },
    "singleProjectMode": true
  }
}
