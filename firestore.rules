rules_version = '2';

// Cada persona solo puede leer y escribir sus propios datos en users/{uid}. Crear y modificar exige que la
// administración haya aprobado su acceso (access/{uid}); leer y borrar no, para que una cuenta pendiente o
// retirada pueda descargar o eliminar lo suyo. Las solicitudes de acceso, la lista de administración y las funciones
// extra de cada cuenta solo las escriben las Cloud Functions. Todo lo que no coincide con estas reglas queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // La marca la escriben las Cloud Functions con el email de la cuenta de administración; además de existir,
    // tiene que ser del email de quien lee
    function isAdmin() {
      let marker = /databases/$(database)/documents/admins/$(request.auth.uid);
      return request.auth != null
        && request.auth.token.email is string
        && exists(marker)
        && get(marker).data.email == request.auth.token.email.lower();
    }

    function hasAccess(uid) {
      let access = /databases/$(database)/documents/access/$(uid);
      return isOwner(uid) && exists(access) && get(access).data.status == 'approved';
    }

    match /access/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
    }

    // Funciones extra de cada cuenta: las concede la administración con la Cloud Function setFeatures. Las lee la
    // propia cuenta y la administración; nadie las escribe desde la app.
    match /features/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    // Sincronización con Google Calendar: el estado de la conexión lo escribe el servidor y solo lo lee la propia
    // cuenta. El permiso de Google (cifrado, en calendar_tokens) no lo lee nadie desde la app, tampoco su dueño.
    match /calendar_status/{uid} {
      allow read: if isOwner(uid);
    }

    // Configuración que fija la administración (p. ej. si hay que aprobar las cuentas): la escriben las Cloud
    // Functions. La lista negra por email (blocked_emails) no la ve nadie desde la app.
    match /settings/{name} {
      allow read: if isAdmin();
    }

    // Mensajes de contacto: los escribe la Cloud Function submitFeedback. La administración los lee y solo cambia
    // su estado (nuevo, leído, cerrado); el contador de envíos (feedback_limits) no lo ve nadie desde la app.
    match /feedback_tickets/{ticketId} {
      allow read: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        && request.resource.data.status in ['new', 'read', 'closed'];
    }

    // Campos del perfil que escribe la app (datos de la cuenta, si ya vio la bienvenida y las novedades, sus áreas de la
    // Rueda, qué funciones extra tiene encendidas, que solo cuenta para la administración, y cuándo aceptó las
    // condiciones); cualquier otro se rechaza
    function onlyProfileFields(keys) {
      return keys.hasOnly([
        'name', 'email', 'photoUrl', 'createdAt', 'lastLoginAt',
        'hasSeenOnboarding', 'onboardingVersion', 'onboardingSeenAt', 'onboardingOutcome',
        'wheelAreas', 'featurePrefs', 'releaseNotesSeen', 'termsAcceptedAt', 'termsVersion'
      ]);
    }

    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if hasAccess(uid) && onlyProfileFields(request.resource.data.keys());
      allow update: if hasAccess(uid) && onlyProfileFields(request.resource.data.diff(resource.data).affectedKeys());

      match /{collection}/{docId} {
        // Tope de tamaño de lo que se escribe, contra abusos (con el registro abierto). Son holgados: los de la app,
        // mucho más pequeños, los aplican el formulario y la importación
        function textAtMost(data, field, max) {
          return !(field in data) || (data[field] is string && data[field].size() <= max);
        }
        function listAtMost(data, field, max) {
          return !(field in data) || (data[field] is list && data[field].size() <= max);
        }
        function withinLimits(data) {
          return data.keys().size() <= 60
            && textAtMost(data, 'title', 2000)
            && textAtMost(data, 'description', 50000)
            && textAtMost(data, 'why', 5000)
            && textAtMost(data, 'subject', 2000)
            && textAtMost(data, 'body', 100000)
            && listAtMost(data, 'observations', 1000)
            && listAtMost(data, 'agendaPoints', 500)
            && listAtMost(data, 'recipients', 500)
            && listAtMost(data, 'attachments', 500)
            && (!('form' in data) || (data.form is map && data.form.keys().size() <= 60));
        }

        allow read, delete: if isOwner(uid)
          && collection in ['tasks', 'wheelLogs', 'meetings', 'emails', 'goals', 'projects', 'taskDrafts'];
        allow create: if hasAccess(uid)
          && collection in ['tasks', 'wheelLogs', 'meetings', 'emails', 'goals', 'projects', 'taskDrafts']
          && withinLimits(request.resource.data);

        // Las evaluaciones de la Rueda de la Vida son append-only: no se modifican.
        // Reescribir el mismo contenido sí se permite para que una importación pueda reintentarse.
        allow update: if hasAccess(uid)
          && collection in ['tasks', 'wheelLogs', 'meetings', 'emails', 'goals', 'projects', 'taskDrafts']
          && withinLimits(request.resource.data)
          && (collection != 'wheelLogs' || request.resource.data == resource.data);
      }
    }
  }
}
