rules_version = '2';

// Cada persona solo puede leer y escribir sus propios datos en users/{uid}, y solo si la administración
// ha aprobado su acceso (access/{uid}). Las solicitudes de acceso y la lista de administración solo las
// escriben las Cloud Functions. Todo lo que no coincide con estas reglas queda denegado.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function hasAccess(uid) {
      let access = /databases/$(database)/documents/access/$(uid);
      return isOwner(uid) && exists(access) && get(access).data.status == 'approved';
    }

    match /access/{uid} {
      allow read: if isOwner(uid) || isAdmin();
    }

    match /admins/{uid} {
      allow read: if isOwner(uid);
    }

    match /users/{uid} {
      allow read, write: if hasAccess(uid);

      match /{collection}/{docId} {
        allow read, create, delete: if hasAccess(uid)
          && collection in ['tasks', 'wheelLogs', 'meetings', 'emails'];

        // Las evaluaciones de la Rueda de la Vida son append-only: no se modifican.
        // Reescribir el mismo contenido sí se permite para que una importación pueda reintentarse.
        allow update: if hasAccess(uid)
          && collection in ['tasks', 'wheelLogs', 'meetings', 'emails']
          && (collection != 'wheelLogs' || request.resource.data == resource.data);
      }
    }
  }
}
