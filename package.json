{
  "name": "react-example",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:exec --only auth,firestore --project demo-neuroproductivity \"npm run dev:app\"",
    "dev:app": "VITE_USE_FIREBASE_EMULATORS=true vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "VITE_USE_FIREBASE_EMULATORS=true vite build && npm --prefix functions run build && firebase emulators:start --only hosting,functions,auth,firestore --project demo-neuroproductivity",
    "deploy": "firebase deploy --only hosting,functions,firestore",
    "clean": "rm -rf dist functions/lib",
    "lint": "tsc --noEmit",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-neuroproductivity \"tsx --test tests/rules/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:rules && npm run test:e2e"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "firebase-tools": "15.33.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
