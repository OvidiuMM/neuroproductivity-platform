{
  "name": "clar",
  "description": "CLAR: decide qué hacer ahora, con claridad. Rueda de la Vida, metas, proyectos y tareas con Top 10, agenda y tiempo protegido.",
  "private": true,
  "version": "0.9.5",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix functions run build && firebase emulators:exec --only auth,firestore,functions --project demo-neuroproductivity \"npm run dev:app\"",
    "dev:app": "VITE_USE_FIREBASE_EMULATORS=true vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "emulators": "VITE_USE_FIREBASE_EMULATORS=true vite build && npm --prefix functions run build && firebase emulators:start --only hosting,functions,auth,firestore --project demo-neuroproductivity",
    "deploy": "firebase deploy --only hosting,functions,firestore",
    "clean": "rm -rf dist functions/lib",
    "typecheck": "tsc --noEmit",
    "lint": "tools/eslint/node_modules/.bin/eslint --config tools/eslint/eslint.config.js --max-warnings 0 .",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "tsx --test tests/unit/*.test.ts",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-neuroproductivity \"tsx --test tests/rules/*.test.ts\"",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:integration && npm run test:rules && npm run test:e2e",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "firebase": "^13.0.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "15.33.0",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "simple-git-hooks": "2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "tools/eslint/node_modules/.bin/eslint --config tools/eslint/eslint.config.js --max-warnings 0 --fix"
    ],
    "*.{js,mjs,cjs,json,md,css,html,yml,yaml}": "prettier --write"
  }
}
